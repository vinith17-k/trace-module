# TRACE Module — Environment Variables
# Copy this file to .env and fill in the secrets marked with REQUIRED.

# ─────────────────────────────────────────────────────────────
# Supabase — public (safe to expose in client JS)
# ─────────────────────────────────────────────────────────────
SUPABASE_PROJECT_ID="odwijcyobmkmfejgyfbi"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_4eTsZEQ6fgt1Av3Zbx-f2A_-ulZd61G"
SUPABASE_URL="https://odwijcyobmkmfejgyfbi.supabase.co"

VITE_SUPABASE_PROJECT_ID="odwijcyobmkmfejgyfbi"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_4eTsZEQ6fgt1Av3Zbx-f2A_-ulZd61G"
VITE_SUPABASE_URL="https://odwijcyobmkmfejgyfbi.supabase.co"

# ─────────────────────────────────────────────────────────────
# Supabase — secret (SERVER-SIDE ONLY, never expose to browser)
# Get from: Supabase Dashboard → Project Settings → API → service_role key
# ─────────────────────────────────────────────────────────────
# REQUIRED — all pipeline DB writes will crash without this.
SUPABASE_SERVICE_ROLE_KEY="REPLACE_WITH_YOUR_SERVICE_ROLE_KEY"

# ─────────────────────────────────────────────────────────────
# Lovable AI Gateway — LLM-powered emotion scoring
# Get from: Lovable Dashboard → Settings → API Keys
# ─────────────────────────────────────────────────────────────
# Optional — if missing, LLM emotion scoring returns all-zeros
# and only lexicon keyword matching contributes to SVI scores.
LOVABLE_API_KEY="REPLACE_WITH_YOUR_LOVABLE_API_KEY"

# ─────────────────────────────────────────────────────────────
# Notification delivery (optional — for future real provider)
# ─────────────────────────────────────────────────────────────
# AUTHORITY_WEBHOOK_URL="https://your-authority-webhook-endpoint.example.com/notify"
# TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# TWILIO_AUTH_TOKEN="your_twilio_auth_token"
